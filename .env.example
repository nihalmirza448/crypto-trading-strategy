# Kraken API Configuration (for data collection)
KRAKEN_API_KEY=Your_exchange_api_key_here
KRAKEN_API_SECRET=Your_exchange_api_secret_here

# Trading Exchange API (Bybit, OKX, etc.)
EXCHANGE_API_KEY=your_exchange_api_key_here
EXCHANGE_API_SECRET=your_exchange_api_secret_here

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Arbitrage strategy (CoinDCX vs Blofin) — required for live trades, optional for --dry-run
COINDCX_API_KEY=your_coindcx_api_key
COINDCX_API_SECRET=your_coindcx_api_secret
BLOFIN_API_KEY=your_blofin_api_key
BLOFIN_SECRET_KEY=your_blofin_secret_key
BLOFIN_PASSPHRASE=your_blofin_passphrase

# CryptoQuant Data API — run: python fetch_cryptoquant_ohlcv.py
# Put your Data API key in ONE of these (sent as Authorization: Bearer <key>):
CRYPTOQUANT_ACCESS_TOKEN=
CRYPTOQUANT_API_KEY=
# Set to 1 only if support tells you to use query-string api_key instead of Bearer:
# CRYPTOQUANT_AUTH_QUERY=1
# Professional: window=day only, max 365 days. Premium: hour/min, longer history.
CRYPTOQUANT_WINDOW=day
CRYPTOQUANT_MAX_LOOKBACK_DAYS=365
CRYPTOQUANT_MARKET=spot
CRYPTOQUANT_EXCHANGE=all_exchange
CRYPTOQUANT_BTC_SYMBOL=btc_usd
CRYPTOQUANT_ETH_SYMBOL=eth_usd

# Forward test (paper) — python forward_test_live.py
FORWARD_TEST_ASSET=eth
FORWARD_TEST_INTERVAL_SEC=3600
FORWARD_FIXED_CAPITAL=1000
FORWARD_LEVERAGE=50
# Live forward test: pull OHLCV from CryptoQuant each cycle (default)
FORWARD_PRICE_SOURCE=cryptoquant
# Vercel forward-test dashboard (GCP VM pushes every 60s — do not commit secrets)
# FORWARD_DASHBOARD_INGEST_URL=https://crypto-forward-dashboard.vercel.app/api/ingest
# FORWARD_INGEST_SECRET=generate_with_openssl_rand_hex_32
# If CQ hour is 403 (Professional plan), set 1 to use Binance for 1h/4h only
# FORWARD_CQ_FALLBACK_BINANCE=0
